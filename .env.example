# ShipBest OMS 接口配置（在 OMS 后台的 API 配置里获取）
SHIPBEST_BASE_URL=https://oms.shipbest.com
SHIPBEST_API_ID=
SHIPBEST_ACCESS_TOKEN=
# 设为 1 时不调用真实接口，使用模拟数据（本地试用 / 演示用）
SHIPBEST_MOCK=0

# 后台登录密码 & 会话签名密钥（请改成足够长的随机字符串）
ADMIN_PASSWORD=change-me
SESSION_SECRET=please-change-to-a-long-random-string

# 数据目录（SQLite 数据库和面单文件）
DATA_DIR=./data
